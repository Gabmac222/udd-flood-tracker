{
  "name": "udd-flood-tracker-react",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:local": "VITE_API_BASE=/api vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test test/data.test.mjs",
    "test:ui": "node test/browser.mjs",
    "server": "node local-server/server.mjs",
    "test:api": "node --test local-server/test/api.test.mjs",
    "build:pages": "vite build && node scripts/stage-pages.mjs",
    "format:check": "prettier --check src public/sw.js index.html vite.config.js test scripts local-server package.json"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@mui/material": "^9.4.0",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.9",
    "vite": "^8.3.1"
  }
}
